# GridGuard Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Settings
# You can use standard DB connection parameters:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gridguard
DB_USER=postgres
DB_PASSWORD=postgres

# Or provide a single PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gridguard

# JWT Authentication Secret
JWT_SECRET=gridguard_super_secret_jwt_key_2026_renewable_energy
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Simulation Settings
SIMULATION_INTERVAL_SECONDS=3
AUTO_START_SIMULATION=true
